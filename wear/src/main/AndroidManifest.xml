<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BIND_WALLPAPER" />

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
        <uses-library
            android:name="wear-sdk"
            android:required="false" />

        <!-- Set to true if your app is Standalone -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- ACTIVITY PRINCIPAL — nombre completamente calificado -->
        <activity
            android:name="mx.utng.smarthealthmonitor.wear.maai.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nombre completamente calificado -->
        <service
            android:name="mx.utng.smarthealthmonitor.wear.maai.HealthDataService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING">
            <intent-filter>
                <action android:name="androidx.health.services.client.PASSIVE_LISTENER" />
            </intent-filter>
        </service>

        <!-- WatchFace básico — Sesión 10 -->
        <service
            android:name="mx.utng.smarthealthmonitor.wear.maai.watchface.HealthWatchFaceService"
            android:exported="true"
            android:label="@string/watch_face_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <!-- Vista previa del WatchFace en el selector -->
            <meta-data
                android:name="com.google.android.wearable.watchface.preview"
                android:resource="@mipmap/ic_launcher" />
            <!-- Descriptor XML requerido por WallpaperService -->
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/watch_face" />
            <!-- Identificador para el WatchFace Editor de Wear OS -->
            <meta-data
                android:name="androidx.wear.watchface.WATCH_FACE_SERVICE"
                android:value="mx.utng.smarthealthmonitor.wear.maai.watchface.HealthWatchFaceService" />
        </service>

    </application>

</manifest>
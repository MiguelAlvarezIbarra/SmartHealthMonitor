<?xml version="1.0" encoding="utf-8"?>
<!-- tv/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declarar que es una app de TV (requerido por Google Play para TV) -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Las TVs no tienen pantalla táctil -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TvApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:banner="@drawable/banner_tv"
        android:icon="@mipmap/ic_launcher"
        android:label="SmartHealth TV"
        android:theme="@style/Theme.SmartHealthTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="SmartHealth TV"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER: hace que aparezca en el launcher de Android TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
